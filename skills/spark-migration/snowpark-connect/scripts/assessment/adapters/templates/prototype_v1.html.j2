function initSparkApiChart() {
  if (typeof Chart === 'undefined') return;
  const canvas = document.getElementById('chart-spark-api');
  if (!canvas) return;

  const cats = ((sparkApiData || {}).categories || []).filter(c => (c.supported + c.unsupported) > 0);
  if (cats.length === 0) return;

  if (chartSparkApi) chartSparkApi.destroy();
  chartSparkApi = new Chart(canvas, {
    type: 'bar',
    data: {
      labels: cats.map(c => c.category),
      datasets: [
        {
          label: 'Supported',
          data: cats.map(c => c.supported),
          backgroundColor: '#51CAA5',
          borderWidth: 0,
          borderRadius: 3
        },
        {
          label: 'Needs attention',
          data: cats.map(c => c.unsupported),
          backgroundColor: '#ECB700',
          borderWidth: 0,
          borderRadius: 3
        }
      ]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          mode: 'index',
          axis: 'y',
          callbacks: {
            title(items) { return items[0].label; },
            label(ctx) {
              const cat = cats[ctx.dataIndex];
              const total = cat.supported + cat.unsupported;
              const pct = total ? Math.round(100 * cat.supported / total) : 0;
              if (ctx.datasetIndex === 0) {
                return ` Supported: ${ctx.raw} · ${pct}% ready`;
              }
              return ` Needs attention: ${ctx.raw}`;
            }
          }
        }
      },
      scales: {
        x: {
          stacked: true,
          beginAtZero: true,
          ticks: { precision: 0, color: '#5D6A85', font: { size: 12, family: 'Inter, sans-serif' } },
          grid: { color: '#f1f5f9' }
        },
        y: {
          stacked: true,
          grid: { display: false },
          ticks: { color: '#5D6A85', font: { size: 13, family: 'Inter, sans-serif' } }
        }
      }
    }
  });

  // Render stat pills below the chart.
  const pillsEl = document.getElementById('spark-api-stat-pills');
  if (pillsEl && (sparkApiData || {}).total > 0) {
    pillsEl.innerHTML =
      `<span class="spark-stat-pill spark-stat-supported">Supported: ${sparkApiData.total_supported} (${sparkApiData.supported_pct}%)</span>` +
      `<span class="spark-stat-pill spark-stat-unsupported">Needs attention: ${sparkApiData.total_unsupported} (${sparkApiData.unsupported_pct}%)</span>`;
  }
}

function initPage() {
  initOverviewCharts();
  initPrerequisitesChart();
  initFileSummaryChart();
  initSparkApiChart();
  initDependencyGraphInteractivity();
  initDataDependencyGraphInteractivity();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initPage);
} else {
  initPage();
}

document.querySelectorAll('.wave-header').forEach(wh => {
  wh.addEventListener('click', () => { wh.parentElement.classList.toggle('open'); });
});

document.querySelectorAll('.collapsible-header').forEach(ch => {
  ch.addEventListener('click', () => { ch.parentElement.classList.toggle('collapsed'); });
});

function detailFor(mainRow) {
  const next = mainRow.nextElementSibling;
  return (next && next.classList.contains('file-detail-row')) ? next : null;
}

document.querySelectorAll('.file-row.expandable').forEach(row => {
  row.addEventListener('click', () => {
    const detail = detailFor(row);
    if (!detail) return;
    const open = detail.dataset.open === '1';
    detail.dataset.open = open ? '0' : '1';
    detail.style.display = open ? 'none' : 'table-row';
    row.classList.toggle('expanded', !open);
  });
});

document.querySelectorAll('#file-table th').forEach((th, idx) => {
  th.style.cursor = 'pointer';
  th.addEventListener('click', () => {
    const table = document.getElementById('file-table');
    const tbody = table.querySelector('tbody');
    const pairs = Array.from(tbody.querySelectorAll('tr.file-row')).map(r => [r, detailFor(r)]);
    const dir = th.dataset.sortDir === 'asc' ? 'desc' : 'asc';
    th.dataset.sortDir = dir;
    pairs.sort((a, b) => {
      let av = a[0].cells[idx].textContent.replace(/\u25b8/g, '').trim();
      let bv = b[0].cells[idx].textContent.replace(/\u25b8/g, '').trim();
      const an = parseFloat(av), bn = parseFloat(bv);
      if (!isNaN(an) && !isNaN(bn)) return dir === 'asc' ? an - bn : bn - an;
      return dir === 'asc' ? av.localeCompare(bv) : bv.localeCompare(av);
    });
    pairs.forEach(([m, d]) => { tbody.appendChild(m); if (d) tbody.appendChild(d); });
  });
});

function filterFileTable() {
  const search = ((document.getElementById('file-search') || {}).value || '').toLowerCase();
  const statusFilter = (document.getElementById('status-filter') || {}).value || '';
  const techFilter = (document.getElementById('tech-filter') || {}).value || '';
  const table = document.getElementById('file-table');
  if (!table) return;
  table.querySelectorAll('tbody tr.file-row').forEach(row => {
    const haystack = row.dataset.search || row.cells[0].textContent.toLowerCase();
    const tech = row.cells[1].textContent.trim();
    /* Filter on the underlying status token (high/medium/low) from data-status,
       not the user-facing label, so the dropdown values stay stable even though
       the visible badge text reads "Ready" / "Some Updates" / "Updates Planned". */
    const status = (row.dataset.status || (row.cells[5] ? row.cells[5].textContent.trim().toLowerCase() : ''));
    const matchSearch = !search || haystack.includes(search);
    const matchStatus = !statusFilter || status === statusFilter;
    const matchTech = !techFilter || tech === techFilter;
    const visible = matchSearch && matchStatus && matchTech;
    row.style.display = visible ? '' : 'none';
    const detail = detailFor(row);
    if (detail) detail.style.display = (visible && detail.dataset.open === '1') ? 'table-row' : 'none';
  });
}

const searchEl = document.getElementById('file-search');
if (searchEl) searchEl.addEventListener('input', filterFileTable);
const statusEl = document.getElementById('status-filter');
if (statusEl) statusEl.addEventListener('change', filterFileTable);
const techEl = document.getElementById('tech-filter');
if (techEl) techEl.addEventListener('change', filterFileTable);

const exportBtn = document.getElementById('export-csv');
if (exportBtn) {
  exportBtn.addEventListener('click', () => {
    const table = document.getElementById('file-table');
    if (!table) return;
    const q = v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
    const header = [
      'File', 'Technology', 'Lines', 'Spark Usages', 'Issues', 'Readiness',
      'Finding Risk', 'Category', 'Finding Lines', 'Language', 'Confidence',
      'Code', 'Root Cause', 'Explanation', 'Suggested Fix',
    ];
    let csv = header.map(q).join(',') + '\n';
    table.querySelectorAll('tbody tr.file-row').forEach(row => {
      if (row.style.display === 'none') return;
      const cells = row.querySelectorAll('td');
      const filePath = (cells[0].getAttribute('title') || cells[0].textContent).replace(/\u25b8/g, '').trim();
      const fileCols = [
        filePath,
        cells[1] ? cells[1].textContent.trim() : '',
        cells[2] ? cells[2].textContent.trim() : '',
        cells[3] ? cells[3].textContent.trim() : '',
        cells[4] ? cells[4].textContent.trim() : '',
        cells[5] ? cells[5].textContent.trim() : '',
      ];
      const detail = detailFor(row);
      const cards = detail ? detail.querySelectorAll('.issue-card') : [];
      if (cards.length === 0) {
        csv += fileCols.concat(['', '', '', '', '', '', '', '', '']).map(q).join(',') + '\n';
        return;
      }
      cards.forEach(card => {
        const findingCols = [
          card.dataset.risk || '',
          card.dataset.category || '',
          card.dataset.lines || '',
          card.dataset.language || '',
          card.dataset.confidence || '',
          card.dataset.code || '',
          card.dataset.rootCause || '',
          card.dataset.explanation || '',
          card.dataset.fix || '',
        ];
        csv += fileCols.concat(findingCols).map(q).join(',') + '\n';
      });
    });
    const blob = new Blob([csv], {type: 'text/csv'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'migration_files.csv'; a.click();
    URL.revokeObjectURL(url);
  });
}

/* ============================================================
   COMPONENT ANALYSIS TABLE
   Data is embedded as a JSON constant; JS handles all interaction.
   ============================================================ */

const PARTITION_TABLE_DATA = {{ partition_table_json | safe }};

(function initPartitionTable() {
  const strategies = (PARTITION_TABLE_DATA.strategies || []).filter(s => s.available);
  const partitionMap = PARTITION_TABLE_DATA.partition_map || {};
  const fileRows = PARTITION_TABLE_DATA.file_rows || {};

  const strategySelect  = document.getElementById('partition-strategy-select');
  const summaryChips    = document.getElementById('partition-summary-chips');
  const strategyDesc    = document.getElementById('partition-strategy-desc');
  const emptyState      = document.getElementById('partition-empty-state');
  const groupsContainer = document.getElementById('partition-groups-container');
  const rowCount        = document.getElementById('partition-row-count');

  if (!strategySelect || !groupsContainer) return;
  if (strategies.length === 0) {
    if (emptyState) { emptyState.style.display = ''; emptyState.textContent = 'No partition data available — no files were scanned.'; }
    return;
  }

  strategies.forEach(s => {
    const opt = document.createElement('option');
    opt.value = s.id;
    opt.textContent = s.label + (s.requires_llm ? ' ★ LLM' : '');
    if (s.default) opt.selected = true;
    strategySelect.appendChild(opt);
  });

  const _BADGE = {
    green:  { bg: '#DFF6DD', text: '#107C10', border: '#A7D7A0' },
    yellow: { bg: '#FFF4CE', text: '#797670', border: '#F0D060' },
    orange: { bg: '#FFE5CC', text: '#8A3B00', border: '#F5B880' },
    blue:   { bg: '#E8F4FD', text: '#11567F', border: '#A8D4EE' },
    gray:   { bg: '#F3F4F6', text: '#4B5563', border: '#D1D5DB' },
  };
  const _NEUTRAL = _BADGE.gray;  // used for non-semantic cluster headers

  const _READINESS = {
    'High':   { bg: '#DFF6DD', text: '#107C10', label: 'Ready' },
    'Medium': { bg: '#FFF4CE', text: '#797670', label: 'Light Refactor' },
    'Low':    { bg: '#FFE5CC', text: '#8A3B00', label: 'Active Refactor' },
  };

  const _EAI = {
    'No':        { bg: '#F3F4F6', text: '#6B7280' },
    'Yes':       { bg: '#FDE7E9', text: '#A4262C' },
    'Yes (UDF)': { bg: '#FDE7E9', text: '#A4262C' },
  };

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function inlineBadge(text, c) {
    return `<span class="badge" style="background:${c.bg};color:${c.text};border:1px solid ${c.border||c.bg};">${escHtml(String(text))}</span>`;
  }

  // ── Pagination state ────────────────────────────────────────────────────────
  // Each cluster table has its own rows-per-page (default 5) and current page.
  const pgPageSize    = {};  // groupLabel → rows per page
  const pgCurrentPage = {};  // groupLabel → current page (1-indexed)

  function pgSize(label)    { return pgPageSize[label]    || 5; }
  function pgPage(label)    { return pgCurrentPage[label] || 1; }
  function pgReset(label)   { delete pgCurrentPage[label]; }
  function pgResetAll()     { Object.keys(pgCurrentPage).forEach(k => delete pgCurrentPage[k]); }

  // ── Event delegation: ar-pkg popovers + prev/next buttons + rows-per-page ───
  groupsContainer.addEventListener('click', function(e) {
    // ar-pkg-btn: toggle popover (same UX as Detailed Compatibility tab)
    const pkgBtn = e.target.closest('.ar-pkg-btn');
    if (pkgBtn) {
      e.stopPropagation();
      const wrap = pkgBtn.closest('.ar-pkg-wrap');
      const isOpen = wrap && wrap.classList.contains('open');
      document.querySelectorAll('.ar-pkg-wrap.open').forEach(w => w.classList.remove('open'));
      if (!isOpen && wrap) wrap.classList.add('open');
      return;
    }

    // pagination buttons
    const btn = e.target.closest('[data-pg-action]');
    if (!btn || btn.disabled) return;
    const action = btn.dataset.pgAction;
    const label  = btn.dataset.pgLabel;
    if (!label) return;
    if (action === 'prev') {
      pgCurrentPage[label] = Math.max(1, pgPage(label) - 1);
    } else if (action === 'next') {
      const total = parseInt(btn.dataset.pgTotal, 10) || 1;
      pgCurrentPage[label] = Math.min(total, pgPage(label) + 1);
    }
    renderPartition(strategySelect.value);
  });

  groupsContainer.addEventListener('change', function(e) {
    const sel = e.target.closest('[data-pg-size-for]');
    if (!sel) return;
    const label = sel.dataset.pgSizeFor;
    pgPageSize[label] = parseInt(sel.value, 10) || 5;
    pgReset(label);
    renderPartition(strategySelect.value);
  });

  // ── Main render ─────────────────────────────────────────────────────────────
  function renderPartition(strategyId) {
    const sDef = strategies.find(s => s.id === strategyId);
    const useColors = !!(sDef && sDef.badge_colors);
    if (strategyDesc && sDef) strategyDesc.textContent = sDef.description;

    const groups = partitionMap[strategyId] || {};
    const groupNames = Object.keys(groups);

    // Summary chips — neutral when strategy doesn't use semantic colors
    if (summaryChips) {
      summaryChips.innerHTML = '';
      groupNames.forEach(g => {
        const gDef = (sDef && sDef.groups || []).find(gd => gd.label === g);
        const c = useColors ? (_BADGE[gDef ? gDef.badge : 'blue'] || _BADGE.blue) : _NEUTRAL;
        const chip = document.createElement('span');
        chip.style.cssText = `display:inline-flex;align-items:center;gap:4px;padding:2px 10px;border-radius:12px;font-size:0.76rem;font-weight:600;font-family:inherit;background:${c.bg};color:${c.text};border:1px solid ${c.border||c.bg};`;
        chip.textContent = `${g} (${(groups[g]||[]).length})`;
        summaryChips.appendChild(chip);
      });
    }

    if (groupNames.length === 0) {
      if (emptyState) { emptyState.style.display = ''; emptyState.textContent = 'No partition data available for this strategy.'; }
      groupsContainer.innerHTML = '';
      if (rowCount) rowCount.textContent = '';
      return;
    }
    if (emptyState) emptyState.style.display = 'none';

    const btnBase = 'padding:3px 10px;border:1px solid var(--border-color);border-radius:4px;font-family:inherit;font-size:0.8rem;';
    const btnOn   = `${btnBase}background:#fff;color:var(--text-primary);cursor:pointer;`;
    const btnOff  = `${btnBase}background:#f8fafc;color:var(--sf-gray);cursor:default;`;
    const selStyle = 'padding:3px 6px;border:1px solid var(--border-color);border-radius:4px;font-family:inherit;font-size:0.8rem;background:#fff;color:var(--text-primary);outline:none;cursor:pointer;';

    let html = '';
    let totalFiles = 0;

    groupNames.forEach((groupLabel, gIdx) => {
      const paths = groups[groupLabel] || [];
      if (paths.length === 0) return;

      const gDef = (sDef && sDef.groups || []).find(gd => gd.label === groupLabel);
      // Cluster header badge: use semantic color only when strategy opts in
      const c = useColors ? (_BADGE[gDef ? gDef.badge : 'blue'] || _BADGE.blue) : _NEUTRAL;
      totalFiles += paths.length;

      const rowsPerPage = pgSize(groupLabel);
      const totalPages  = Math.max(1, Math.ceil(paths.length / rowsPerPage));
      if (pgPage(groupLabel) > totalPages) pgCurrentPage[groupLabel] = totalPages;
      const curPage  = pgPage(groupLabel);
      const start    = (curPage - 1) * rowsPerPage;
      const showEnd  = Math.min(start + rowsPerPage, paths.length);
      const pagePaths = paths.slice(start, showEnd);
      const safeLabel = escHtml(groupLabel);
      const prevOff   = curPage <= 1;
      const nextOff   = curPage >= totalPages;

      html += `
        <div style="margin-bottom:1.5rem;">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:0.5rem;">
            <span style="font-size:0.8rem;font-weight:600;color:var(--sf-gray);">Cluster ${gIdx+1}/${groupNames.length}</span>
            <span style="font-size:0.875rem;font-weight:700;color:${c.text};background:${c.bg};border:1px solid ${c.border||c.bg};padding:2px 10px;border-radius:4px;">${safeLabel}</span>
            <span style="font-size:0.8rem;color:var(--sf-gray);">${paths.length} file${paths.length!==1?'s':''}</span>
          </div>
          <div style="overflow-x:auto;">
            <table>
              <thead>
                <tr>
                  <th>File</th>
                  <th>Technology</th>
                  <th>Readiness</th>
                  <th>Source System</th>
                  <th>Target Type</th>
                  <th>EAI Required</th>
                  <th>AR Required</th>
                  <th style="text-align:right;">Lines</th>
                  <th style="text-align:right;">Blast Radius</th>
                </tr>
              </thead>
              <tbody>`;

      pagePaths.forEach(path => {
        const r = fileRows[path];
        if (!r) return;

        const rb  = _READINESS[r.readiness] || _READINESS['High'];
        const src = (r.source_systems || ['N/A']).join(', ');
        const tgt = (r.target_types   || ['N/A']).join(', ');

        // EAI cell: clickable popover matching Detailed Compatibility tab
        const eaiVal  = r.eai_required || 'No';
        const eaiPkgs = r.eai_packages || [];
        let eaiCell;
        if (eaiVal === 'No') {
          eaiCell = '<span class="badge badge-green">No</span>';
        } else {
          const udfStyle = eaiVal === 'Yes (UDF)' ? ' style="background:#FFE5CC;color:#8A3B00;border-color:#c97a3b;"' : '';
          const eaiItems = eaiPkgs.map(p => `<li>${escHtml(p)}</li>`).join('');
          const eaiBody  = eaiPkgs.length ? `<ul>${eaiItems}</ul>` : `<span style="color:var(--gray);font-size:0.8rem;">No packages listed</span>`;
          eaiCell = `<span class="ar-pkg-wrap"><button class="ar-pkg-btn" type="button"${udfStyle}>${escHtml(eaiVal)} &#9662;</button><div class="ar-pkg-popover"><div class="ar-pkg-title">Requires External Access Integration</div>${eaiBody}</div></span>`;
        }

        // AR cell: clickable popover matching Detailed Compatibility tab
        const arVal  = r.ar_required || 'No';
        const arPkgs = r.ar_packages || [];
        let arCell;
        if (arVal === 'No') {
          arCell = '<span class="badge badge-green">No</span>';
        } else if (arVal === 'N/A') {
          arCell = '<span style="color:var(--gray);">N/A</span>';
        } else {
          const arItems = arPkgs.map(p => `<li>${escHtml(p)}</li>`).join('');
          const arBody  = arPkgs.length ? `<ul>${arItems}</ul>` : `<span style="color:var(--gray);font-size:0.8rem;">No packages listed</span>`;
          arCell = `<span class="ar-pkg-wrap"><button class="ar-pkg-btn" type="button">Yes &#9662;</button><div class="ar-pkg-popover"><div class="ar-pkg-title">Needs Artifact Repository</div>${arBody}</div></span>`;
        }

        let fileHtml = '';
        if (path.includes('/')) {
          const parts = path.split('/');
          const base  = parts.pop();
          fileHtml = `<span style="color:var(--sf-gray);font-size:0.72rem;">${escHtml(parts.join('/'))}/</span><br><span style="font-weight:600;">${escHtml(base)}</span>`;
        } else {
          fileHtml = `<span style="font-weight:600;">${escHtml(path)}</span>`;
        }

        html += `<tr>
          <td title="${escHtml(path)}">${fileHtml}</td>
          <td>${escHtml(r.technology || '—')}</td>
          <td>${inlineBadge(rb.label, rb)}</td>
          <td style="white-space:nowrap;" title="${escHtml(src)}">${escHtml(src.length>32?src.substring(0,30)+'…':src)}</td>
          <td style="white-space:nowrap;" title="${escHtml(tgt)}">${escHtml(tgt.length>30?tgt.substring(0,28)+'…':tgt)}</td>
          <td>${eaiCell}</td>
          <td>${arCell}</td>
          <td style="text-align:right;">${r.lines?r.lines.toLocaleString():'—'}</td>
          <td style="text-align:right;">${r.blast_radius>0?r.blast_radius:'—'}</td>
        </tr>`;
      });

      html += `</tbody></table></div>`;

      // Per-table footer: rows-per-page selector + pagination controls
      html += `<div style="display:flex;align-items:center;gap:12px;margin-top:6px;font-size:0.8rem;color:var(--sf-gray);">
        <span>Rows per page:</span>
        <select data-pg-size-for="${safeLabel}" style="${selStyle}">
          <option value="5"  ${rowsPerPage===5 ?'selected':''}>5</option>
          <option value="10" ${rowsPerPage===10?'selected':''}>10</option>
          <option value="25" ${rowsPerPage===25?'selected':''}>25</option>
          <option value="50" ${rowsPerPage===50?'selected':''}>50</option>
        </select>`;

      if (totalPages > 1) {
        html += `
        <button data-pg-action="prev" data-pg-label="${safeLabel}"
          ${prevOff?'disabled':''} style="${prevOff?btnOff:btnOn}">&#8249; Prev</button>
        <span>Page ${curPage} of ${totalPages} &nbsp;&middot;&nbsp; ${start+1}–${showEnd} of ${paths.length}</span>
        <button data-pg-action="next" data-pg-label="${safeLabel}" data-pg-total="${totalPages}"
          ${nextOff?'disabled':''} style="${nextOff?btnOff:btnOn}">Next &#8250;</button>`;
      } else {
        html += `<span>${paths.length} file${paths.length!==1?'s':''}</span>`;
      }

      html += `</div></div>`;
    });

    groupsContainer.innerHTML = html;

    if (rowCount) {
      rowCount.textContent = `${totalFiles} file${totalFiles!==1?'s':''} across ${groupNames.length} cluster${groupNames.length!==1?'s':''}.`;
    }
  }

  function onStrategyChange() {
    pgResetAll();
    renderPartition(strategySelect.value);
  }

  const defaultStrategy = strategies.find(s => s.default) || strategies[0];
  if (defaultStrategy) {
    strategySelect.value = defaultStrategy.id;
    onStrategyChange();
  }

  strategySelect.addEventListener('change', onStrategyChange);
})();

// =========================================================
// MERGED FILE COMPATIBILITY TABLE — interactive behaviour
// =========================================================
(function() {
  'use strict';

  const MERGED_TABLE_ID = 'merged-file-table';

  // ---- Dynamic technology filter ----
  (function populateTechFilter() {
    var sel = document.getElementById('merged-tech-filter');
    if (!sel) return;
    var table = document.getElementById(MERGED_TABLE_ID);
    if (!table) return;
    var seen = new Set();
    table.querySelectorAll('tbody tr.file-row').forEach(function(row) {
      var t = (row.dataset.tech || '').trim();
      if (t) seen.add(t);
    });
    var sorted = Array.from(seen).sort();
    sorted.forEach(function(tech) {
      var opt = document.createElement('option');
      opt.value = tech;
      opt.textContent = tech;
      sel.appendChild(opt);
    });
  })();

  // ---- Utility helpers ----

  function uniqueList(items) {
    var seen = new Set();
    return (items || []).filter(function(item) {
      var key = String(item).trim();
      if (!key || seen.has(key)) return false;
      seen.add(key);
      return true;
    });
  }

  function cellToList(cell) {
    if (!cell) return [];
    var parts = cell.innerHTML
      .replace(/<br\s*\/?>/gi, '\n')
      .replace(/<[^>]+>/g, '')
      .split('\n')
      .map(function(s) { return s.trim(); })
      .filter(function(s) { return s && s !== '—'; });
    return parts.length ? parts : [];
  }

  function _formatRequirementForDetail(cellHTML, badgeColor, title) {
    if (!cellHTML || cellHTML.indexOf('ar-pkg-wrap') === -1) {
      return cellHTML || '<span class="badge badge-green">No</span>';
    }
    var tmp = document.createElement('div');
    tmp.innerHTML = cellHTML;
    var pkgList = tmp.querySelector('.ar-pkg-popover ul');
    var detailsHTML = pkgList ? pkgList.outerHTML : '';
    return '<div class="file-detail-ar">'
      + '<span class="badge badge-' + badgeColor + '">' + title + '</span>'
      + (detailsHTML ? '<div class="file-detail-ar-details">' + detailsHTML + '</div>' : '')
      + '</div>';
  }

  function formatArRequirementForDetail(arHTML) {
    return _formatRequirementForDetail(arHTML, 'yellow', 'Yes');
  }

  function formatEaiRequirementForDetail(eaiHTML) {
    return _formatRequirementForDetail(eaiHTML, 'yellow', 'Yes');
  }

  function _esc(v) {
    return String(v || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function renderEndpointTable(rowHeader, items, fmts, locs) {
    var maxLen = Math.max(items.length, 1);
    var rows = '';
    for (var i = 0; i < maxLen; i++) {
      var fmtVal = fmts[i] !== undefined ? fmts[i] : (fmts.length > 0 ? '' : '—');
      rows += '<tr>'
        + '<td>' + _esc(items[i] || '—') + '</td>'
        + '<td>' + _esc(i === 0 && !fmts.length ? '—' : (fmtVal || '')) + '</td>'
        + '<td>' + _esc(locs[i] || (i === 0 ? '—' : '')) + '</td>'
        + '</tr>';
    }
    // Fixed column widths so both Sources and Targets tables align
    return '<div class="file-endpoints-table-wrap" style="margin-bottom:12px;">'
      + '<table class="file-endpoints-table" style="table-layout:fixed;width:100%;">'
      + '<colgroup><col style="width:30%"><col style="width:30%"><col style="width:40%"></colgroup>'
      + '<thead><tr><th>' + rowHeader + '</th><th>File formats</th><th>Location</th></tr></thead>'
      + '<tbody>' + rows + '</tbody></table></div>';
  }

  function renderAdditionalInfoPanel(row, panel) {
    var cells = row.querySelectorAll('td');
    var tech = (row.dataset.tech || '').trim() || '—';
    var tgtLoc = (row.dataset.targetLocation || '').trim();
    var eaiHTML = cells[4] ? cells[4].innerHTML : '';
    var arHTML  = cells[5] ? cells[5].innerHTML : '';
    var linesText = cells[6] ? cells[6].textContent.trim() : '';
    var sparkText = cells[7] ? cells[7].textContent.trim() : '';
    var issuesText = cells[8] ? cells[8].textContent.trim() : '';
    var recipeCount = panel ? parseInt(panel.dataset.recipeCount || '0', 10) : 0;

    var eai = formatEaiRequirementForDetail(eaiHTML);
    var ar = formatArRequirementForDetail(arHTML);

    var metricsSection = '<section class="file-detail-section">'
      + '<div class="tiles" style="grid-template-columns:repeat(5,1fr);margin-bottom:0;">'
      + '<div class="tile"><div class="label">Technology</div><div class="value">' + tech + '</div></div>'
      + '<div class="tile"><div class="label">Lines</div><div class="value">' + (linesText || '—') + '</div></div>'
      + '<div class="tile"><div class="label">Spark usages</div><div class="value">' + (sparkText || '—') + '</div></div>'
      + '<div class="tile"><div class="label">Issues</div><div class="value">' + (issuesText || '—') + '</div></div>'
      + '<div class="tile"><div class="label">Recipes applied</div><div class="value">' + (recipeCount || '—') + '</div></div>'
      + '</div></section>';

    // Sources: connection (source_system) | file formats | source location (not in model → —)
    var srcSystems = uniqueList(cellToList(cells[1]));
    var fmts = uniqueList(cellToList(cells[3]));
    // Targets: target type | file formats | target location
    var tgtTypes = uniqueList(cellToList(cells[2]));
    var tgtLoc_list = tgtLoc ? [tgtLoc] : [];

    var sourcesSection = '<section class="file-detail-section"><h2>Sources and targets</h2>'
      + renderEndpointTable('Source system', srcSystems, fmts, [])
      + renderEndpointTable('Target type', tgtTypes, fmts, tgtLoc_list)
      + '</section>';

    var requirementsSection = '<section class="file-detail-section"><h2>Requirements</h2>'
      + '<div class="file-detail-requirements">'
      + '<div class="file-detail-requirement"><h3>External access integration required</h3>'
      + '<div class="file-detail-requirement-body">' + eai + '</div></div>'
      + '<div class="file-detail-requirement"><h3>Artifact repository required</h3>'
      + '<div class="file-detail-requirement-body">' + ar + '</div></div>'
      + '</div></section>';

    return metricsSection + sourcesSection + requirementsSection;
  }

  function escapePath(path) {
    if (typeof CSS !== 'undefined' && typeof CSS.escape === 'function') return CSS.escape(path);
    return String(path).replace(/\\/g, '\\\\').replace(/"/g, '\\"');
  }

  // ---- Detail page show/hide ----

  function showFileDetailPage(row) {
    var page = document.getElementById('file-detail-page');
    var main = document.getElementById('detailed-main');
    if (!page || !main || !row) return;

    var path = row.dataset.filePath
      || (row.cells && row.cells[0] ? row.cells[0].getAttribute('title') || '' : '');
    if (!path) return;

    var store = document.getElementById('file-detail-store');
    var panel = store
      ? store.querySelector('.file-detail-panel[data-file-path="' + escapePath(path) + '"]')
      : null;

    var title = document.getElementById('file-detail-title');
    var readinessPanel = document.getElementById('file-detail-panel-readiness');
    var preprocessingPanel = document.getElementById('file-detail-panel-preprocessing');
    var additionalPanel = document.getElementById('file-detail-panel-additional-info');
    var preprocessingTab = document.getElementById('file-detail-tab-preprocessing');
    if (!title || !readinessPanel || !additionalPanel) return;

    title.textContent = path;

    // Readiness tab: issue cards from .fd-readiness sub-div
    var readinessSrc = panel ? panel.querySelector('.fd-readiness') : null;
    var cards = readinessSrc ? readinessSrc.querySelectorAll('.issue-card') : [];
    readinessPanel.innerHTML = cards.length
      ? readinessSrc.innerHTML
      : '<p class="file-detail-empty">No compatibility findings for this file.</p>';

    // Pre-processing tab: recipe cards from .fd-preprocessing (tab hidden when absent)
    var prepSrc = panel ? panel.querySelector('.fd-preprocessing') : null;
    var hasPrep = prepSrc && prepSrc.querySelectorAll('.issue-card').length > 0;
    if (preprocessingTab) preprocessingTab.style.display = hasPrep ? '' : 'none';
    if (preprocessingPanel) {
      if (hasPrep) {
        var recipeCount = panel ? parseInt(panel.dataset.recipeCount || '0', 10) : 0;
        var prepDesc = '<p style="margin-bottom:1rem;color:var(--gray);font-size:0.85rem;">'
          + 'Deterministic pre-processing resolved <strong>' + recipeCount + '</strong> item'
          + (recipeCount === 1 ? '' : 's') + ' in this file before the analyzer ran. '
          + '<em>rewrite</em> — code was mechanically transformed to a Snowpark Connect equivalent; '
          + '<em>annotate</em> — a <code># SCOS-WARN</code> or <code># SCOS-TODO</code> comment was '
          + 'inserted to flag a pattern without changing the logic. '
          + 'The <strong>Recipe</strong> field names the specific transformation applied.</p>';
        preprocessingPanel.innerHTML = prepDesc + prepSrc.innerHTML;
      } else {
        preprocessingPanel.innerHTML = '<p class="file-detail-empty">No deterministic pre-processing was applied to this file.</p>';
      }
    }

    // Additional info tab
    if (additionalPanel) {
      additionalPanel.innerHTML = renderAdditionalInfoPanel(row, panel);
    }

    // Reset to Readiness tab active
    page.querySelectorAll('.file-detail-tab').forEach(function(tab) {
      var active = tab.dataset.fileTab === 'readiness';
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    page.querySelectorAll('.file-detail-tab-panel').forEach(function(panelEl) {
      panelEl.classList.toggle('active', panelEl.id === 'file-detail-panel-readiness');
    });

    main.classList.add('hidden-for-file-detail');
    page.classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function hideFileDetailPage() {
    var main = document.getElementById('detailed-main');
    var page = document.getElementById('file-detail-page');
    if (main) main.classList.remove('hidden-for-file-detail');
    if (page) page.classList.remove('active');
    var section = document.getElementById('merged-compat-section');
    if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ---- Event wiring ----

  var mergedTbody = document.querySelector('#' + MERGED_TABLE_ID + ' tbody');
  if (mergedTbody) {
    mergedTbody.addEventListener('click', function(e) {
      var row = e.target.closest('tr.file-row');
      if (!row) return;
      if (e.target.closest('.ar-pkg-wrap')) return;
      showFileDetailPage(row);
    });
  }

  var backBtn = document.getElementById('file-detail-back');
  if (backBtn) backBtn.addEventListener('click', hideFileDetailPage);

  document.querySelectorAll('.file-detail-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      var tabId = tab.dataset.fileTab;
      document.querySelectorAll('.file-detail-tab').forEach(function(t) {
        var active = t === tab;
        t.classList.toggle('active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      document.querySelectorAll('.file-detail-tab-panel').forEach(function(panelEl) {
        panelEl.classList.toggle('active', panelEl.id === 'file-detail-panel-' + tabId);
      });
    });
  });

  // ---- Column sort with visual sort icons ----
  document.querySelectorAll('#' + MERGED_TABLE_ID + ' thead th').forEach(function(th, idx) {
    th.addEventListener('click', function() {
      var table = document.getElementById(MERGED_TABLE_ID);
      var tbody = table.querySelector('tbody');
      var allRows = Array.from(tbody.querySelectorAll('tr.file-row'));
      var dir = th.dataset.sortDir === 'asc' ? 'desc' : 'asc';
      // Reset all headers, update clicked one
      table.querySelectorAll('thead th').forEach(function(h) {
        h.dataset.sortDir = '';
        var ic = h.querySelector('.sort-icon');
        if (ic) ic.textContent = '↕';
      });
      th.dataset.sortDir = dir;
      var ic = th.querySelector('.sort-icon');
      if (ic) ic.textContent = dir === 'asc' ? '↑' : '↓';
      allRows.sort(function(a, b) {
        var av = a.cells[idx] ? a.cells[idx].textContent.replace(/[↕↑↓▸]/g, '').trim() : '';
        var bv = b.cells[idx] ? b.cells[idx].textContent.replace(/[↕↑↓▸]/g, '').trim() : '';
        var an = parseFloat(av), bn = parseFloat(bv);
        if (!isNaN(an) && !isNaN(bn)) return dir === 'asc' ? an - bn : bn - an;
        return dir === 'asc' ? av.localeCompare(bv) : bv.localeCompare(av);
      });
      allRows.forEach(function(r) { tbody.appendChild(r); });
    });
  });

  // ---- Filter ----
  function filterMergedFileTable() {
    var search = ((document.getElementById('merged-file-search') || {}).value || '').toLowerCase();
    var statusFilter = ((document.getElementById('merged-status-filter') || {}).value || '');
    var techFilter = ((document.getElementById('merged-tech-filter') || {}).value || '');
    var hideCb = document.getElementById('merged-hide-insignificant');
    var hideInsig = hideCb ? hideCb.checked : false;
    var table = document.getElementById(MERGED_TABLE_ID);
    if (!table) return;
    table.querySelectorAll('tbody tr.file-row').forEach(function(row) {
      var haystack = (row.dataset.search || row.cells[0].textContent).toLowerCase();
      var status = row.dataset.status || '';
      var tech = row.dataset.tech || '';
      var insignificant = row.dataset.insignificant === 'true';
      var visible = (!search || haystack.includes(search))
        && (!statusFilter || status === statusFilter)
        && (!techFilter || tech === techFilter)
        && (!hideInsig || !insignificant);
      row.style.display = visible ? '' : 'none';
    });
  }

  var searchEl = document.getElementById('merged-file-search');
  if (searchEl) searchEl.addEventListener('input', filterMergedFileTable);
  var statusEl = document.getElementById('merged-status-filter');
  if (statusEl) statusEl.addEventListener('change', filterMergedFileTable);
  var techEl2 = document.getElementById('merged-tech-filter');
  if (techEl2) techEl2.addEventListener('change', filterMergedFileTable);
  var hideEl = document.getElementById('merged-hide-insignificant');
  if (hideEl) hideEl.addEventListener('change', filterMergedFileTable);
  filterMergedFileTable();

  // ---- CSV export (10-column) ----
  var exportBtn = document.getElementById('merged-export-csv');
  if (exportBtn) {
    exportBtn.addEventListener('click', function() {
      var table = document.getElementById(MERGED_TABLE_ID);
      if (!table) return;
      var q = function(v) { return '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"'; };
      var cleanAr = function(cell) {
        if (!cell) return '';
        return cell.querySelector('.ar-pkg-wrap') ? 'Yes' : cell.textContent.trim();
      };
      var header = [
        'File','Source system','Target type','File formats','EAI required','AR required',
        'Lines','Spark usages','Issues','Readiness',
        'Finding Risk','Category','Finding Lines','Language','Confidence',
        'Code','Root Cause','Explanation','Suggested Fix',
      ];
      var csv = header.map(q).join(',') + '\n';
      var store = document.getElementById('file-detail-store');
      table.querySelectorAll('tbody tr.file-row').forEach(function(row) {
        if (row.style.display === 'none') return;
        var cells = row.querySelectorAll('td');
        var filePath = (cells[0] ? cells[0].getAttribute('title') || cells[0].textContent : '').trim();
        var fileCols = [
          filePath,
          cells[1] ? cells[1].textContent.trim() : '',
          cells[2] ? cells[2].textContent.trim() : '',
          cells[3] ? cells[3].textContent.trim() : '',
          cells[4] ? cells[4].textContent.trim() : '',
          cleanAr(cells[5]),
          cells[6] ? cells[6].textContent.trim() : '',
          cells[7] ? cells[7].textContent.trim() : '',
          cells[8] ? cells[8].textContent.trim() : '',
          cells[9] ? cells[9].textContent.trim() : '',
        ];
        var panel = store
          ? store.querySelector('.file-detail-panel[data-file-path="' + escapePath(filePath) + '"]')
          : null;
        var readinessSrc = panel ? panel.querySelector('.fd-readiness') : null;
        var cards = readinessSrc ? readinessSrc.querySelectorAll('.issue-card') : [];
        if (cards.length === 0) {
          csv += fileCols.concat(['','','','','','','','','']).map(q).join(',') + '\n';
          return;
        }
        cards.forEach(function(card) {
          csv += fileCols.concat([
            card.dataset.risk || '',
            card.dataset.category || '',
            card.dataset.lines || '',
            card.dataset.language || '',
            card.dataset.confidence || '',
            card.dataset.code || '',
            card.dataset.rootCause || '',
            card.dataset.explanation || '',
            card.dataset.fix || '',
          ]).map(q).join(',') + '\n';
        });
      });
      var blob = new Blob([csv], { type: 'text/csv' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url; a.download = 'migration_files.csv'; a.click();
      URL.revokeObjectURL(url);
    });
  }

  // ---- AR / EAI popover toggle (event delegation covers all .ar-pkg-btn on the page) ----
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.ar-pkg-btn');
    if (btn) {
      e.stopPropagation();
      var wrap = btn.closest('.ar-pkg-wrap');
      var isOpen = wrap.classList.contains('open');
      document.querySelectorAll('.ar-pkg-wrap.open').forEach(function(w) { w.classList.remove('open'); });
      if (!isOpen) wrap.classList.add('open');
      return;
    }
    document.querySelectorAll('.ar-pkg-wrap.open').forEach(function(w) { w.classList.remove('open'); });
  });

})(); // end merged file compatibility IIFE
</script>
</body>
</html>
