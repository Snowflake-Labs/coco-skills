/* Dependency-graph blast-radius highlighting: click a node to highlight it
   and every file that transitively imports it (the jobs that break if its
   interface changes); dim the rest. */
const dependentsAdjacency = {{ dependents_adjacency_json | safe }};

function initDependencyGraphInteractivity() {
  const svg = document.getElementById('dep-graph-svg');
  if (!svg) return;
  const nodes = Array.from(svg.querySelectorAll('.dep-node'));
  const edges = Array.from(svg.querySelectorAll('.dep-edge'));
  const statusEl = document.getElementById('dep-graph-status');
  const bg = document.getElementById('dep-graph-bg');
  let activeId = null;

  function blastRadius(startId) {
    // All files that transitively import startId (reverse-reachable set).
    const reached = new Set();
    const stack = [startId];
    while (stack.length) {
      const cur = stack.pop();
      const importers = dependentsAdjacency[cur] || [];
      for (const imp of importers) {
        if (!reached.has(imp)) { reached.add(imp); stack.push(imp); }
      }
    }
    return reached;
  }

  function reset() {
    activeId = null;
    nodes.forEach(n => { n.style.opacity = '1'; });
    edges.forEach(e => { e.style.opacity = '0.55'; e.setAttribute('stroke', '#94a3b8'); });
    if (statusEl) statusEl.textContent = '';
  }

  function highlight(id) {
    const set = blastRadius(id);
    set.add(id);
    nodes.forEach(n => { n.style.opacity = set.has(n.dataset.nodeId) ? '1' : '0.12'; });
    edges.forEach(e => {
      const on = set.has(e.dataset.src) && set.has(e.dataset.tgt);
      e.style.opacity = on ? '0.9' : '0.05';
      e.setAttribute('stroke', on ? '#1A6CE7' : '#94a3b8');
    });
    if (statusEl) {
      const count = set.size - 1;
      statusEl.textContent = count === 0
        ? `${id} — nothing else imports this; it's a safe leaf to migrate.`
        : `${id} — ${count} file(s) transitively import this and would be affected if its interface changes.`;
    }
  }

  nodes.forEach(n => {
    n.addEventListener('click', (ev) => {
      ev.stopPropagation();
      const id = n.dataset.nodeId;
      if (activeId === id) { reset(); return; }
      activeId = id;
      highlight(id);
    });
  });
  if (bg) bg.addEventListener('click', reset);
}

/* Data-dependency-graph consumer highlighting: click a chain node to highlight
   it and every file that transitively consumes its data output; dim the rest.
   Hover any node to highlight it and its bidirectional IMPORT-graph
   neighbours (files it imports AND files that import it) — mirrors how
   IDEs surface dependency adjacency. */
const dataConsumersAdjacency = {{ data_consumers_adjacency_json | safe }};
const importAdjacency = {{ import_adjacency_json | safe }};
const endpointDetail = {{ endpoint_detail_json | safe }};

function initDataDependencyGraphInteractivity() {
  const svg = document.getElementById('data-dep-graph-svg');
  if (!svg) return;
  const nodes = Array.from(svg.querySelectorAll('.data-dep-node'));
  const edges = Array.from(svg.querySelectorAll('.data-dep-edge'));
  const statusEl = document.getElementById('data-dep-graph-status');
  const bg = document.getElementById('data-dep-graph-bg');
  const panel = document.getElementById('data-dep-detail-panel');
  const panelName = document.getElementById('data-dep-detail-name');
  const panelPath = document.getElementById('data-dep-detail-path');
  const panelSources = document.getElementById('data-dep-detail-sources');
  const panelSinks = document.getElementById('data-dep-detail-sinks');
  const panelClose = document.getElementById('data-dep-detail-close');
  let activeId = null;
  let hoverId = null;

  function consumerRadius(startId) {
    // All files that transitively consume data from startId (forward-reachable).
    const reached = new Set();
    const stack = [startId];
    while (stack.length) {
      const cur = stack.pop();
      const consumers = dataConsumersAdjacency[cur] || [];
      for (const c of consumers) {
        if (!reached.has(c)) { reached.add(c); stack.push(c); }
      }
    }
    return reached;
  }

  function renderUriList(ul, uris) {
    if (!ul) return;
    ul.innerHTML = '';
    if (!uris || uris.length === 0) {
      const li = document.createElement('li');
      li.textContent = 'None';
      li.style.color = 'var(--gray)';
      li.style.fontStyle = 'italic';
      li.style.padding = '2px 0';
      ul.appendChild(li);
      return;
    }
    for (const uri of uris) {
      const li = document.createElement('li');
      li.style.padding = '3px 0';
      li.style.borderBottom = '1px solid #f3f4f6';
      const code = document.createElement('code');
      code.textContent = uri;
      code.style.wordBreak = 'break-all';
      code.style.fontSize = '0.78rem';
      code.style.color = '#1f2937';
      li.appendChild(code);
      ul.appendChild(li);
    }
  }

  const panelSourceSystem = document.getElementById('data-dep-detail-source-system');
  const panelTargetType   = document.getElementById('data-dep-detail-target-type');
  const panelEai          = document.getElementById('data-dep-detail-eai');
  const panelAr           = document.getElementById('data-dep-detail-ar');
  const panelFileFormats  = document.getElementById('data-dep-detail-file-formats');

  function flagColor(val) {
    if (!val || val === 'No' || val === 'N/A') return '#6b7280';
    return '#b45309';
  }

  function openPanel(id) {
    if (!panel) return;
    const info = endpointDetail[id];
    if (!info) {
      closePanel();
      return;
    }
    if (panelName) panelName.textContent = info.name || id;
    if (panelPath) panelPath.textContent = info.path || id;
    if (panelSourceSystem) {
      var srcArr = Array.isArray(info.source_system) ? info.source_system : (info.source_system ? [info.source_system] : []);
      panelSourceSystem.textContent = srcArr.filter(function(s){return s && s !== 'N/A';}).join(', ') || 'N/A';
    }
    if (panelTargetType) {
      var tgtArr = Array.isArray(info.target_type) ? info.target_type : (info.target_type ? [info.target_type] : []);
      panelTargetType.textContent = tgtArr.filter(function(t){return t && t !== 'N/A';}).join(', ') || 'N/A';
    }
    if (panelEai) {
      panelEai.textContent = info.eai_required || 'No';
      panelEai.style.color = flagColor(info.eai_required);
    }
    if (panelAr) {
      const pkgs = info.ar_packages && info.ar_packages.length
        ? ` (${info.ar_packages.join(', ')})` : '';
      panelAr.textContent = (info.ar_required || 'No') + pkgs;
      panelAr.style.color = flagColor(info.ar_required);
    }
    if (panelFileFormats) {
      panelFileFormats.innerHTML = '';
      const fmts = Array.isArray(info.file_formats) ? info.file_formats : [];
      if (fmts.length === 0) {
        const s = document.createElement('span');
        s.textContent = '—';
        s.style.color = 'var(--gray)';
        panelFileFormats.appendChild(s);
      } else {
        fmts.forEach(function(f) {
          const tag = document.createElement('span');
          tag.textContent = f;
          tag.style.cssText = 'display:inline-block;font-size:0.73rem;background:#f3f4f6;border:1px solid #e5e7eb;border-radius:3px;padding:1px 5px;margin:1px 2px 1px 0;white-space:nowrap;font-weight:600;color:#374151;';
          panelFileFormats.appendChild(tag);
        });
      }
    }
    renderUriList(panelSources, info.sources || []);
    renderUriList(panelSinks, info.sinks || []);
    panel.style.display = 'block';
  }

  function closePanel() {
    if (panel) panel.style.display = 'none';
  }

  function reset() {
    activeId = null;
    closePanel();
    nodes.forEach(n => { n.style.opacity = '1'; });
    edges.forEach(e => {
      e.style.opacity = '0.85';
      // Preserve the original stroke for each edge kind (orchestrates edges
      // should stay blue, factory edges purple, framework edges gray).
      if (e.classList.contains('data-dep-edge-orchestrates')) {
        e.setAttribute('stroke', '#1A6CE7');
      } else if (e.classList.contains('data-dep-edge-factory')) {
        e.setAttribute('stroke', '#8b5cf6');
      } else if (e.classList.contains('data-dep-edge-framework')) {
        e.setAttribute('stroke', '#94a3b8');
      } else {
        e.setAttribute('stroke', '#4b5563');
      }
    });
    if (statusEl) statusEl.textContent = '';
  }

  function applyHighlight(set, message) {
    nodes.forEach(n => { n.style.opacity = set.has(n.dataset.nodeId) ? '1' : '0.12'; });
    edges.forEach(e => {
      const on = set.has(e.dataset.src) && set.has(e.dataset.tgt);
      e.style.opacity = on ? '1' : '0.05';
      e.setAttribute('stroke', on ? '#1A6CE7' : '#4b5563');
    });
    if (statusEl && message !== undefined) {
      statusEl.textContent = message;
    }
  }

  function highlightConsumers(id) {
    const set = consumerRadius(id);
    set.add(id);
    const count = set.size - 1;
    const message = count === 0
      ? `${id} — no downstream consumers; safe to migrate independently.`
      : `${id} — ${count} file(s) transitively consume its data and must be migrated after it.`;
    applyHighlight(set, message);
  }

  function highlightImportAdjacency(id) {
    const entry = importAdjacency[id] || {orchestrates: [], orchestrated_by: [], data_produces_to: [], data_consumes_from: []};
    const orchestrates = entry.orchestrates || [];
    const orchestratedBy = entry.orchestrated_by || [];
    const dataProducesTo = entry.data_produces_to || [];
    const dataConsumesFrom = entry.data_consumes_from || [];
    const set = new Set([id, ...orchestrates, ...orchestratedBy, ...dataProducesTo, ...dataConsumesFrom]);
    const noNeighbours = orchestrates.length === 0 && orchestratedBy.length === 0
                       && dataProducesTo.length === 0 && dataConsumesFrom.length === 0;
    let message;
    if (noNeighbours) {
      message = `${id} — no data-flow neighbours.`;
    } else {
      const parts = [];
      if (dataProducesTo.length)   parts.push(`feeds data to ${dataProducesTo.length} file(s)`);
      if (dataConsumesFrom.length) parts.push(`consumes data from ${dataConsumesFrom.length} file(s)`);
      if (orchestrates.length)     parts.push(`orchestrates ${orchestrates.length} file(s)`);
      if (orchestratedBy.length)   parts.push(`orchestrated by ${orchestratedBy.length} file(s)`);
      message = `${id} — ${parts.join(', ')}.`;
    }
    applyHighlight(set, message);
  }

  nodes.forEach(n => {
    const id = n.dataset.nodeId;
    // Click behavior — forward-chain highlight for data consumers PLUS
    // opening the side panel with the file's full external-endpoint list.
    // Second click on the same node collapses both (see ``reset``).
    n.addEventListener('click', (ev) => {
      ev.stopPropagation();
      if (activeId === id) { reset(); return; }
      activeId = id;
      highlightConsumers(id);
      openPanel(id);
    });
    // Symmetric hover: any node with an entry in importAdjacency
    // (i.e. every real code file in the data DAG) shows its
    // bidirectional import neighbours.
    if (Object.prototype.hasOwnProperty.call(importAdjacency, id)) {
      n.addEventListener('mouseenter', () => {
        if (activeId) return;
        hoverId = id;
        highlightImportAdjacency(id);
      });
      n.addEventListener('mouseleave', () => {
        if (activeId) return;
        if (hoverId === id) {
          hoverId = null;
          reset();
        }
      });
    }
  });
  if (bg) bg.addEventListener('click', reset);
  if (panelClose) panelClose.addEventListener('click', (ev) => { ev.stopPropagation(); reset(); });
  // Click-outside: if a panel is open, clicks that miss both the SVG
  // and the panel itself close the panel and clear the highlight.
  document.addEventListener('click', (ev) => {
    if (!activeId) return;
    if (panel && panel.contains(ev.target)) return;
    if (svg.contains(ev.target)) return;
    reset();
  });
  // Escape key closes the panel + clears highlight.
  document.addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape' && activeId) {
      reset();
    }
  });
}

let chartFileSummary = null;
let chartSparkApi = null;

const fileSummaryData = {{ file_summary_chart_json | safe }};
const sparkApiData = {{ spark_api_chart_json | safe }};

function initFileSummaryChart() {
  if (typeof Chart === 'undefined') return;
